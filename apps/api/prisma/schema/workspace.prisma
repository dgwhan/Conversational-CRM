enum WorkspaceMemberRole {
    OWNER
    STAFF

    @@map("workspace_member_role")
}

enum WorkspaceMemberStatus {
    PENDING
    ACTIVE
    DECLINED
    CANCELLED

    @@map("workspace_member_status")
}

model Workspace {
    id          String              @id @default(uuid()) @db.Uuid
    name        String              @db.VarChar(255)
    slug        String              @unique @db.VarChar(100)
    ownerId     String              @map("owner_id") @db.Uuid
    isActive    Boolean             @default(true) @map("is_active")
    createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

    owner           User                @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
    members         WorkspaceMember[]
    channelAccounts ChannelAccount[]
    customers       Customer[]
    customerImportJobs CustomerImportJob[]
    conversations   Conversation[]
    configuration   WorkspaceConfiguration?
    notifications   Notification[]
    activities      Activity[]
    deals           Deal[]
    contacts        Contact[]

    @@index([ownerId])
    @@map("workspaces")
}

model WorkspaceConfiguration {
    id              String    @id @default(uuid()) @db.Uuid
    workspaceId     String?   @unique @map("workspace_id") @db.Uuid
    ownerId         String    @map("owner_id") @db.Uuid
    domain          String    @default("EDUCATION") @db.VarChar(50)
    workspaceName   String?   @map("workspace_name") @db.VarChar(255)
    terminology     Json      @default("{}") @db.JsonB
    pipelineStages  Json      @default("[]") @map("pipeline_stages") @db.JsonB
    productCatalog  Json      @default("[]") @map("product_catalog") @db.JsonB
    criteria        Json      @default("[]") @db.JsonB
    leadScoringConfig Json?    @map("lead_scoring_config") @db.JsonB
    /// Mẫu trả lời nhanh dùng chung cho cả nhóm (null = chưa cấu hình, giao diện dùng mẫu mặc định)
    quickReplies    Json?     @map("quick_replies") @db.JsonB
    createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

    workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    owner           User       @relation("UserWorkspaceConfig", fields: [ownerId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@map("workspace_configurations")
}

model WorkspaceMember {
    id          String                @id @default(uuid()) @db.Uuid
    workspaceId String                @map("workspace_id") @db.Uuid
    userId      String                @map("user_id") @db.Uuid
    role        WorkspaceMemberRole   @default(STAFF)
    status      WorkspaceMemberStatus @default(PENDING) @map("status")
    isActive    Boolean               @default(true) @map("is_active")
    invitedById String?               @map("invited_by_id") @db.Uuid
    invitedAt   DateTime              @default(now()) @map("invited_at") @db.Timestamptz(3)
    joinedAt    DateTime?             @map("joined_at") @db.Timestamptz(3)
    createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

    workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    invitedBy             User?          @relation("MemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)
    assignedConversations Conversation[]
    activities            Activity[]
    assignedDeals         Deal[]

    @@unique([workspaceId, userId])
    @@index([workspaceId, status])
    @@index([userId, status])
    @@index([workspaceId])
    @@index([userId])
    @@map("workspace_members")
}
