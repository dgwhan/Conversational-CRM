enum Channel {
    ZALO
    FACEBOOK
    TIKTOK
    MANUAL_IMPORT

    @@map("channel")
}

enum MessageDirection {
    INBOUND
    OUTBOUND

    @@map("message_direction")
}

enum ConversationStatus {
    OPEN
    PENDING
    RESOLVED

    @@map("conversation_status")
}

model ChannelAccount {
    id                  String    @id @default(uuid()) @db.Uuid
    workspaceId         String?   @map("workspace_id") @db.Uuid
    channel             Channel
    externalAccountId   String    @map("external_account_id")
    displayName         String    @map("display_name")
    avatarUrl           String?   @map("avatar_url")
    encryptedAccessToken String?  @map("encrypted_access_token") @db.Text
    refreshToken        String?   @map("refresh_token") @db.Text
    tokenExpiresAt      DateTime? @map("token_expires_at") @db.Timestamptz(3)
    disconnectedAt      DateTime? @map("disconnected_at") @db.Timestamptz(3)
    isWebhookSubscribed Boolean   @default(false) @map("is_webhook_subscribed")
    metadata            Json?     @map("metadata") @db.JsonB
    isActive            Boolean   @default(true) @map("is_active")
    createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

    workspace           Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    messages            Message[]
    conversations       Conversation[]

    @@unique([channel, externalAccountId])
    @@index([workspaceId])
    @@map("channel_accounts")
}

model Customer {
    id                   String             @id @default(uuid()) @db.Uuid
    workspaceId          String?            @map("workspace_id") @db.Uuid
    fullName             String             @map("full_name")
    phone                String?            @db.VarChar(50)
    phoneNormalized      String?            @map("phone_normalized") @db.VarChar(50)
    email                String?            @db.VarChar(255)
    idCard               String?            @map("id_card") @db.VarChar(50)
    school               String?            @db.VarChar(255)
    address              String?            @db.Text
    dateOfBirth          DateTime?          @map("date_of_birth") @db.Date
    avatarUrl            String?            @map("avatar_url")
    leadStatus           String             @default("NEW") @map("lead_status") @db.VarChar(50)
    leadStage            String?            @map("lead_stage") @db.VarChar(50)
    notes                String?            @db.Text
    channelIdentities    Json?              @map("channel_identities") @db.JsonB
    isMerged             Boolean            @default(false) @map("is_merged")
    mergedIntoCustomerId String?            @map("merged_into_customer_id") @db.Uuid
    /// Nguồn khách hàng (VD: "Ngày hội tư vấn 2026", "Google Form"); khách đến từ kênh chat để trống
    source               String?            @db.VarChar(150)
    /// Lô import đã tạo khách hàng này (dùng để lọc và hoàn tác)
    importJobId          String?            @map("import_job_id") @db.Uuid
    createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

    workspace            Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    conversations        Conversation[]
    identities           ChannelIdentity[]
    mergeLogsTarget      CustomerMergeLog[] @relation("MergeTargetCustomer")
    activities           Activity[]
    deals                Deal[]
    importJob            CustomerImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

    @@index([workspaceId])
    @@index([phone])
    @@index([phoneNormalized])
    @@index([email])
    @@index([leadStatus])
    @@index([leadStage])
    @@index([isMerged])
    @@index([mergedIntoCustomerId])
    @@index([workspaceId, importJobId])
    @@map("customers")
}

/// Một lần nhập danh sách khách hàng từ file CSV/XLSX
model CustomerImportJob {
    id                String     @id @default(uuid()) @db.Uuid
    workspaceId       String     @map("workspace_id") @db.Uuid
    createdById       String?    @map("created_by_id") @db.Uuid
    createdByName     String?    @map("created_by_name") @db.VarChar(255)
    fileName          String     @map("file_name") @db.VarChar(255)
    /// COMPLETED | UNDONE
    status            String     @default("COMPLETED") @db.VarChar(30)
    /// SKIP | FILL_EMPTY | OVERWRITE
    duplicateStrategy String     @map("duplicate_strategy") @db.VarChar(30)
    source            String?    @db.VarChar(150)
    totalRows         Int        @default(0) @map("total_rows")
    createdCount      Int        @default(0) @map("created_count")
    updatedCount      Int        @default(0) @map("updated_count")
    skippedCount      Int        @default(0) @map("skipped_count")
    errorCount        Int        @default(0) @map("error_count")
    /// Danh sách lỗi theo dòng (tối đa 1000 mục) để tải lại file lỗi
    errors            Json       @default("[]") @db.JsonB
    undoneAt          DateTime?  @map("undone_at") @db.Timestamptz(3)
    undoneCount       Int        @default(0) @map("undone_count")
    createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

    workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    customers         Customer[]

    @@index([workspaceId, createdAt])
    @@map("customer_import_jobs")
}

model Conversation {
    id                    String              @id @default(uuid()) @db.Uuid
    workspaceId           String?             @map("workspace_id") @db.Uuid
    channelAccountId      String              @map("channel_account_id") @db.Uuid
    customerId            String?             @map("customer_id") @db.Uuid
    assignedMemberId      String?             @map("assigned_member_id") @db.Uuid
    status                ConversationStatus  @default(OPEN)
    snippet               String?             @db.Text
    unreadCount           Int                 @default(0) @map("unread_count")
    tags                  String[]            @default([])
    lastMessageAt         DateTime?           @map("last_message_at") @db.Timestamptz(3)
    lastCustomerMessageAt DateTime?           @map("last_customer_message_at") @db.Timestamptz(3)
    createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

    workspace             Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    channelAccount        ChannelAccount      @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
    customer              Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
    assignedMember        WorkspaceMember?    @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
    messages              Message[]

    @@index([workspaceId, lastMessageAt])
    @@index([channelAccountId])
    @@index([customerId])
    @@index([assignedMemberId])
    @@map("conversations")
}

model Message {
    id                String           @id @default(uuid()) @db.Uuid
    conversationId    String?          @map("conversation_id") @db.Uuid
    channelAccountId  String           @map("channel_account_id") @db.Uuid
    channel           Channel
    direction         MessageDirection
    content           String?          @db.Text
    attachments       Json?            @map("attachments") @db.JsonB
    sentAt            DateTime         @map("sent_at") @db.Timestamptz(3)
    externalMessageId String           @map("external_message_id")
    rawPayload        Json             @map("raw_payload") @db.JsonB
    processedAt       DateTime?        @map("processed_at") @db.Timestamptz(3)
    createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

    channelAccount    ChannelAccount   @relation(fields: [channelAccountId], references: [id], onDelete: Restrict)
    conversation      Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@unique([channel, externalMessageId])
    @@index([channelAccountId, sentAt])
    @@index([conversationId])
    @@map("messages")
}
