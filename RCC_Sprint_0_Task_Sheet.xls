<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Borders/>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#000000"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
  <Style ss:ID="Header">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
   </Borders>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#0F172A" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="CategoryBanner">
   <Alignment ss:Horizontal="Left" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#0284C7"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#BAE6FD"/>
   </Borders>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="12" ss:Color="#0369A1" ss:Bold="1"/>
   <Interior ss:Color="#E0F2FE" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="TitleStyle">
   <Alignment ss:Horizontal="Left" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="15" ss:Color="#0F172A" ss:Bold="1"/>
  </Style>
  <Style ss:ID="SubTitleStyle">
   <Alignment ss:Horizontal="Left" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="10" ss:Color="#64748B" ss:Italic="1"/>
  </Style>
  <Style ss:ID="DataCell">
   <Alignment ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10"/>
  </Style>
  <Style ss:ID="DataCellCenter">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10"/>
  </Style>
  <Style ss:ID="CodeBadge">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#1E293B" ss:Bold="1"/>
   <Interior ss:Color="#F1F5F9" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="StatusDone">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#047857" ss:Bold="1"/>
   <Interior ss:Color="#D1FAE5" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="StatusPending">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#B45309" ss:Bold="1"/>
   <Interior ss:Color="#FEF3C7" ss:Pattern="Solid"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="Bảng Ký hiệu &amp; Giải thích">
  <Table ss:DefaultRowHeight="22">
   <Column ss:Width="80"/>
   <Column ss:Width="220"/>
   <Column ss:Width="380"/>
   <Column ss:Width="250"/>
   <Row ss:Height="30">
    <Cell ss:MergeAcross="3" ss:StyleID="TitleStyle"><Data ss:Type="String">BẢNG DANH MỤC KÝ HIỆU PHÂN HỆ HỆ THỐNG CUSC-CRM</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:MergeAcross="3" ss:StyleID="SubTitleStyle"><Data ss:Type="String">Quy ước mã viết tắt các module và phạm vi nghiệp vụ tương ứng</Data></Cell>
   </Row>
   <Row ss:Height="8"></Row>
   <Row ss:Height="26">
    <Cell ss:StyleID="Header"><Data ss:Type="String">Ký hiệu</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Tên Phân hệ (Module)</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Giải thích chức năng &amp; Nghiệp vụ</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Phạm vi ứng dụng</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">PLT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Nền tảng &amp; Hạ tầng (Platform)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Thiết lập khung ứng dụng Monorepo, NestJS backend framework, Docker Compose, cơ sở dữ liệu PostgreSQL qua Prisma ORM, quản lý biến môi trường và tài liệu kiến trúc.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Hạ tầng cốt lõi cho toàn bộ hệ thống</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">IAM</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Xác thực &amp; Phân quyền (Identity &amp; Access)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Quản lý tài khoản người dùng, đăng ký, đăng nhập, phân quyền theo vai trò (Admin / Agent / Manager), đổi mật khẩu, cơ chế chống vượt quyền (Broken Access Control) và ghi nhật ký truy cập (Access Log).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Bảo mật và tài khoản người dùng</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">MSG</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Nhắn tin &amp; Hội thoại Đa kênh (Messaging)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tiếp nhận và gửi tin nhắn tập trung đa nền tảng: Tích hợp Webhook kết nối Facebook Fanpage (Messenger), Zalo cá nhân, TikTok Shop, bộ khử trùng tin nhắn, xử lý hàng đợi Worker và ghi nhận người gửi (Attribution).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tiếp nhận và xử lý tương tác trực tiếp với khách hàng</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">CUS</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Quản lý Khách hàng (Customer)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Hồ sơ khách hàng tập trung: Tự động tạo/tìm khách hàng khi có tin nhắn mới, chuẩn hóa định dạng số điện thoại Việt Nam, gộp dữ liệu trùng lặp theo số điện thoại, API quản lý và cơ chế ẩn danh/xóa dữ liệu.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cơ sở dữ liệu thông tin học viên &amp; phụ huynh</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">CLS</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Phân loại &amp; Chấm điểm Lead (Classification &amp; NLP)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Xử lý ngôn ngữ tự nhiên (NLP): Chuẩn hóa văn bản tiếng Việt, trích xuất thông tin trọng tâm, từ điển ngành đào tạo CUSC, hàm tính điểm quan tâm (Scoring), phân loại dịch vụ/sự kiện và kết nối cổng LLM xử lý tin nhắn mơ hồ.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đánh giá mức độ tiềm năng tự động bằng AI/Luật</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">LEAD</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Quản lý Lead Tuyển sinh (Lead Pipeline)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Mô hình dữ liệu Lead, máy trạng thái chu trình tư vấn (State Machine), quy tắc phân công tư vấn viên phụ trách, ghi chú nội bộ, checklist hồ sơ, phát hiện lead nguội/không phản hồi và xuất danh sách.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Quy trình tư vấn và chuyển đổi từ tương tác thành học viên</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">NTF</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Thông báo &amp; Cảnh báo (Notifications)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cổng gửi thông báo đa kênh, tích hợp Telegram Bot cảnh báo tức thì, gửi email dự phòng, quét vi phạm thời gian cam kết phản hồi (SLA) và báo động ngay khi có Lead Nóng mới.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đôn đốc và nhắc nhở tư vấn viên kịp thời</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">WEB</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Giao diện Ứng dụng Web (Frontend)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Giao diện trực quan cho người dùng: Cổng đăng nhập &amp; bảo vệ đường dẫn (Route Protection), Hộp thư đa kênh (Inbox), màn hình danh sách Lead, chi tiết Lead, màn hình quản lý nhân sự và Bảng tổng quan (Dashboard).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Màn hình làm việc trực tiếp của tư vấn viên và quản lý</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">CAS</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Quản lý Vụ việc (Case Management)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Theo dõi và giải quyết các trường hợp/vụ việc hỗ trợ cụ thể: Mô hình trạng thái vụ việc, nhận diện nhu cầu cần can thiệp đặc biệt, giao diện API và cảnh báo SLA vụ việc.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Hỗ trợ giải quyết khiếu nại hoặc trường hợp đặc biệt</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">RPT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Báo cáo &amp; Thống kê (Reports &amp; Analytics)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Truy vấn số liệu tổng hợp, đo lường tốc độ phản hồi tin nhắn của nhân viên tư vấn, tỷ lệ chuyển đổi thành học viên thực tế và cơ chế tự động đồng bộ báo cáo sang Google Sheets / Excel.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Phục vụ ban lãnh đạo đo lường hiệu quả tuyển sinh</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">QLT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử &amp; Đảm bảo Chất lượng (Quality &amp; Testing)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Bộ kiểm thử kiến trúc, test quy trình nghiệp vụ đầu cuối (End-to-end), kiểm tra an toàn bảo mật Webhook, bảo vệ dữ liệu cá nhân theo quy định, kịch bản sao lưu &amp; phục hồi dữ liệu và test tải nhẹ.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đảm bảo hệ thống vận hành ổn định, an toàn và tin cậy</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CodeBadge"><Data ss:Type="String">EXT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tích hợp Ngoại vi &amp; Tính năng Mở rộng (External)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Xin cấp quyền chính thức từ Meta (Facebook App Review), đăng ký Zalo Official Account (OA), chuẩn hóa giao diện đa ngôn ngữ, hiệu ứng Skeleton Loading khi tải dữ liệu và chuẩn bị môi trường chạy thật.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Mở rộng tính năng và hoàn tất thủ tục nền tảng bên thứ ba</Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <FreezePanes/>
   <FrozenNoSplit/>
   <SplitHorizontal>4</SplitHorizontal>
   <TopRowBottomPane>4</TopRowBottomPane>
   <ActivePane>2</ActivePane>
  </WorksheetOptions>
 </Worksheet>
