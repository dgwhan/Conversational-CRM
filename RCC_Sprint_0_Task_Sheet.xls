   </Row>
   <Row ss:Height="20">
    <Cell ss:MergeAcross="7" ss:StyleID="SubTitleStyle"><Data ss:Type="String">Đã lược bỏ Bug/Subtask - Nhóm theo phân hệ với dải phân cách trực quan</Data></Cell>
   </Row>
   <Row ss:Height="8"></Row>
   <Row ss:Height="26">
    <Cell ss:StyleID="Header"><Data ss:Type="String">STT</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Mã Jira</Data></Cell>
