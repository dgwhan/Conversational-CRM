# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
POSTGRES_HOST=

# Database Connection URL
# Ví dụ: postgresql://postgres:password@localhost:5432/recruitment_crm?schema=public
DATABASE_URL=
DATABASE_URL_TEST=
# (Tùy chọn) Ghi đè chuỗi kết nối cho container api trong docker-compose.
# Mặc định compose dùng host "postgres"/"redis" của mạng Docker, không dùng localhost.
# DATABASE_URL_DOCKER=
# REDIS_URL_DOCKER=

# ==========================================
# Redis (BẮT BUỘC ở production)
# ==========================================
# Dùng cho: hàng đợi BullMQ xử lý tin inbound, rate limit, presence, pub/sub realtime và khóa cron
# giữa nhiều instance. Bỏ trống chỉ được phép ở development/test (khi đó dùng bộ nhớ tiến trình, chỉ 1 instance).
# Ví dụ local: redis://localhost:6379   |   trong docker-compose: redis://redis:6379
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Instance này có chạy worker xử lý tin inbound không (true/false, mặc định true)
INBOUND_WORKER_ENABLED=true
INBOUND_WORKER_CONCURRENCY=5

# Proxy tin cậy để đọc X-Forwarded-For (mặc định: không tin, req.ip = IP kết nối thật).
# Đặt số hop (vd: 1 khi có một Nginx/Load Balancer phía trước) hoặc danh sách IP/CIDR của proxy.
TRUST_PROXY=

# ==========================================
# Authentication & Security Secrets (JWT)
# ==========================================
# Khóa JWT bí mật (tối thiểu 32 ký tự, bắt buộc cấu hình trong file .env thực tế)
JWT_ACCESS_SECRET=

# Thời hạn Access Token (ví dụ: '15m' cho Production, '1h' cho Development). Mặc định 15m.
JWT_ACCESS_TTL=10800m
# JWT_EXPIRES_IN_MINUTES đã DEPRECATED: chỉ có hiệu lực khi JWT_ACCESS_TTL bỏ trống

# Thời hạn Refresh Token (tính theo ngày)
REFRESH_TTL_DAYS=7

JWT_ISSUER=CUSC-Recruitment-CRM
JWT_AUDIENCE=CUSC-Recruitment-CRM-Client

# Khóa mã hóa Token AES-256-GCM (BẮT BUỘC, tối thiểu 32 ký tự, dùng mã hóa Page Access Token)
# Không có giá trị mặc định. Sinh khóa riêng cho từng môi trường, ví dụ: openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=

# ==========================================
# SMTP Mail Delivery (Để trống nếu không dùng chức năng gửi mail)
# ==========================================
# Ví dụ Gmail SMTP: host smtp.gmail.com, port 587, MAIL_SECURE=false
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ==========================================
# Password Recovery Cryptographic Keys (RFC 4226 / NIST SP 800-38D)
# Tạo 3 khóa base64 32-byte độc lập bằng lệnh: openssl rand -base64 32
# ==========================================
PASSWORD_RECOVERY_EMAIL_HMAC_KEY=
PASSWORD_RECOVERY_OTP_HMAC_KEY=
PASSWORD_RECOVERY_OTP_ENCRYPTION_KEY=

# Password Recovery Rate Limiting & Cooldowns
PASSWORD_RECOVERY_IP_REQUEST_LIMIT=
PASSWORD_RECOVERY_EMAIL_REQUEST_LIMIT=
PASSWORD_RECOVERY_IP_VERIFY_LIMIT=
PASSWORD_RECOVERY_IP_RESET_LIMIT=
PASSWORD_RECOVERY_RESET_TOKEN_TTL_SECONDS=
PASSWORD_RECOVERY_RATE_WINDOW_SECONDS=
PASSWORD_RECOVERY_RESEND_COOLDOWN_SECONDS=
PASSWORD_RECOVERY_DELIVERY_POLL_INTERVAL_SECONDS=
PASSWORD_RECOVERY_DELIVERY_LEASE_SECONDS=
PASSWORD_RECOVERY_DELIVERY_MAX_ATTEMPTS=
PASSWORD_RECOVERY_DELIVERY_RETRY_BASE_SECONDS=
PASSWORD_RECOVERY_DELIVERY_BATCH_SIZE=
PASSWORD_RECOVERY_DELIVERY_MAX_RETRY_DELAY_SECONDS=
PASSWORD_RECOVERY_CHALLENGE_STATE_RETRY_LIMIT=
PASSWORD_RECOVERY_RATE_LIMIT_SERIALIZATION_RETRY_LIMIT=

# ==========================================
# Social Media OAuth Credentials (Meta / Zalo / TikTok)
# ==========================================
# Meta / Facebook for Developers
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Zalo for Developers
ZALO_APP_ID=
ZALO_APP_SECRET=
# Khóa ký webhook Zalo OA (nếu khác ZALO_APP_SECRET). Production + Zalo bật => bắt buộc có 1 trong 2
ZALO_OA_SECRET_KEY=

# Media proxy (tùy chọn): giới hạn dung lượng (byte, mặc định 26214400 = 25MB) và danh sách hậu tố domain CDN cho phép
# MEDIA_PROXY_MAX_BYTES=26214400
# MEDIA_PROXY_ALLOWED_HOSTS=zdn.vn,zadn.vn,fbcdn.net

# TikTok for Business
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ==========================================
# Frontend Web Client Configuration (Vite)
# ==========================================
VITE_API_BASE_URL=
VITE_AUTH_SESSION_KEY=
VITE_ACTIVE_WORKSPACE_KEY=
VITE_USER_ROLE_KEY=
VITE_WORKSPACE_CONFIG_KEY=polarisx_crm_workspace_config_v1

# ==========================================
# Seed dữ liệu demo (pnpm prisma:seed) - chỉ dùng cho development
# ==========================================
# Bỏ trống mật khẩu -> seed tự sinh mật khẩu ngẫu nhiên và in ra một lần cho tài khoản mới tạo.
# Seed KHÔNG ghi đè user/mật khẩu đã tồn tại và từ chối chạy khi NODE_ENV=production.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
