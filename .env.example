# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
POSTGRES_HOST=

# Database Connection URL
# Ví dụ: postgresql://postgres:password@localhost:5432/recruitment_crm?schema=public
DATABASE_URL=
DATABASE_URL_TEST=

# ==========================================
# Authentication & Security Secrets (JWT)
# ==========================================
# Khóa JWT bí mật (tối thiểu 32 ký tự, bắt buộc cấu hình trong file .env thực tế)
JWT_ACCESS_SECRET=

# Thời hạn Access Token (ví dụ: '15m' cho Production, '1h' cho Development)
JWT_ACCESS_TTL=15m
JWT_EXPIRES_IN_MINUTES=15

# Thời hạn Refresh Token (tính theo ngày)
REFRESH_TTL_DAYS=7

JWT_ISSUER=CUSC-Recruitment-CRM
JWT_AUDIENCE=CUSC-Recruitment-CRM-Client

# Khóa mã hóa Token AES-256-GCM (tối thiểu 32 ký tự, dùng mã hóa Page Access Token)
TOKEN_ENCRYPTION_KEY=

# ==========================================
# SMTP Mail Delivery (Để trống nếu không dùng chức năng gửi mail)
# ==========================================
# Ví dụ Gmail SMTP: host smtp.gmail.com, port 587, MAIL_SECURE=false
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ==========================================
# Password Recovery Cryptographic Keys (RFC 4226 / NIST SP 800-38D)
# Tạo 3 khóa base64 32-byte độc lập bằng lệnh: openssl rand -base64 32
# ==========================================
PASSWORD_RECOVERY_EMAIL_HMAC_KEY=
PASSWORD_RECOVERY_OTP_HMAC_KEY=
PASSWORD_RECOVERY_OTP_ENCRYPTION_KEY=

# Password Recovery Rate Limiting & Cooldowns
PASSWORD_RECOVERY_IP_REQUEST_LIMIT=20
PASSWORD_RECOVERY_EMAIL_REQUEST_LIMIT=5
PASSWORD_RECOVERY_IP_VERIFY_LIMIT=20
PASSWORD_RECOVERY_IP_RESET_LIMIT=10
PASSWORD_RECOVERY_RESET_TOKEN_TTL_SECONDS=900
PASSWORD_RECOVERY_RATE_WINDOW_SECONDS=900
PASSWORD_RECOVERY_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RECOVERY_DELIVERY_POLL_INTERVAL_SECONDS=5
PASSWORD_RECOVERY_DELIVERY_LEASE_SECONDS=60
PASSWORD_RECOVERY_DELIVERY_MAX_ATTEMPTS=5
PASSWORD_RECOVERY_DELIVERY_RETRY_BASE_SECONDS=30
PASSWORD_RECOVERY_DELIVERY_BATCH_SIZE=20
PASSWORD_RECOVERY_DELIVERY_MAX_RETRY_DELAY_SECONDS=3600
PASSWORD_RECOVERY_CHALLENGE_STATE_RETRY_LIMIT=20
PASSWORD_RECOVERY_RATE_LIMIT_SERIALIZATION_RETRY_LIMIT=3

# ==========================================
# Social Media OAuth Credentials (Meta / Zalo / TikTok)
# ==========================================
# Meta / Facebook for Developers
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Zalo for Developers
ZALO_APP_ID=
ZALO_APP_SECRET=

# TikTok for Business
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ==========================================
# Frontend Web Client Configuration (Vite)
# ==========================================
VITE_API_BASE_URL=/api
VITE_AUTH_SESSION_KEY=polarisx_crm_auth_session
VITE_ACTIVE_WORKSPACE_KEY=polarisx_crm_active_workspace_id
VITE_USER_ROLE_KEY=polarisx_crm_user_role
